<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#faf8ff"/>
      <stop offset="100%" style="stop-color:#eaedff"/>
    </linearGradient>
    <linearGradient id="circle" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00b4d8"/>
      <stop offset="100%" style="stop-color:#00677d"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <circle cx="280" cy="315" r="200" fill="url(#circle)" opacity="0.15"/>
  <circle cx="280" cy="315" r="150" fill="url(#circle)" opacity="0.25"/>
  <circle cx="280" cy="315" r="110" fill="url(#circle)"/>
  <!-- Doctor avatar silhouette -->
  <circle cx="280" cy="270" r="45" fill="white" opacity="0.9"/>
  <ellipse cx="280" cy="370" rx="70" ry="50" fill="white" opacity="0.9"/>
  <!-- Text content -->
  <text x="520" y="200" font-family="system-ui,sans-serif" font-size="20" font-weight="700" fill="#00677d" letter-spacing="3">SENIOR INTERVENTIONAL CARDIOLOGIST</text>
  <text x="520" y="280" font-family="system-ui,sans-serif" font-size="58" font-weight="800" fill="#131b2e">Dr. Rohan Sharma</text>
  <text x="520" y="340" font-family="system-ui,sans-serif" font-size="24" fill="#515f78">MD, DM Cardiology • AIIMS New Delhi • FACC</text>
  <text x="520" y="400" font-family="system-ui,sans-serif" font-size="22" fill="#515f78">GK-1 Clinic  •  Max Saket  •  Medanta  •  Video OPD</text>
  <!-- Book button -->
  <rect x="520" y="450" width="280" height="56" rx="28" fill="#00b4d8"/>
  <text x="660" y="484" font-family="system-ui,sans-serif" font-size="20" font-weight="700" fill="white" text-anchor="middle">Book Consultation →</text>
  <!-- NMC badge -->
  <text x="520" y="580" font-family="system-ui,sans-serif" font-size="16" fill="#6d797e">NMC Reg. #54219  •  Delhi Medical Council</text>
</svg>
